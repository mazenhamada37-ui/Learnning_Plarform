rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Educational platform collections allowing cross-device real-time sync
    match /courses/{courseId} {
      allow read, write: if true;
    }
    match /courseRequests/{requestId} {
      allow read, write: if true;
    }
    match /students/{studentId} {
      allow read, write: if true;
    }
    match /pendingStudents/{studentId} {
      allow read, write: if true;
    }
    match /instructors/{instructorId} {
      allow read, write: if true;
    }
    match /pendingInstructors/{instructorId} {
      allow read, write: if true;
    }
    match /studentProgress/{studentId} {
      allow read, write: if true;
    }
    match /platformMeta/{metaId} {
      allow read, write: if true;
    }
    match /courseReviews/{reviewId} {
      allow read, write: if true;
    }
    // Fallback rule for any other collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
