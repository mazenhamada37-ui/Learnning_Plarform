rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read and write for educational platform collections to allow seamless real-time sync across mobile and laptop
    match /courses/{courseId} {
      allow read, write: if true;
    }
    match /courseRequests/{requestId} {
      allow read, write: if true;
    }
    match /students/{studentId} {
      allow read, write: if true;
    }
    match /instructors/{instructorId} {
      allow read, write: if true;
    }
    match /platformMeta/{metaId} {
      allow read, write: if true;
    }
    match /courseReviews/{reviewId} {
      allow read, write: if true;
    }
    // Fallback rule for any other collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
